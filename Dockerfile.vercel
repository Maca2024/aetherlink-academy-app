FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS build

WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@11.19.0

COPY . .
RUN node scripts/setup.mjs

FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS runtime

ARG SOURCE_REVISION=unknown
ENV SOURCE_REVISION=$SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/RyanLisse/aetherlink-academy-app" \
      org.opencontainers.image.revision=$SOURCE_REVISION

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates tini \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /tmp/academy-data && chown node:node /tmp/academy-data

# Vercel may override PORT in project settings. Keep the existing app port so
# the unprivileged node user can bind it; Proof stays private on loopback.
ENV NODE_ENV=production \
  HOST=0.0.0.0 \
  PORT=4317 \
  PROOF_PORT=4400 \
  ACADEMY_STORAGE=postgres \
  ACADEMY_DATA=/tmp/academy-data

USER node
EXPOSE 4317
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/game/health').then(async r=>{const b=await r.json();process.exit(r.ok&&b.proof?0:1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "scripts/start.mjs"]
